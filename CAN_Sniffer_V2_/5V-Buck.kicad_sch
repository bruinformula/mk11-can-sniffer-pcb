	(text "LDO max power dissipation (theoretical for onboard): \nP_D = (150-25)/88 = 1.42W\n(assuming amb temp = 25 deg C)\n\nLDO needed power dissipation: (5-3.3)*0.6 = 1.02W\n->should be ok, pls correct if dis estimate is wrong"
		(exclude_from_sim no)
		(at 64.77 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3ef0d948-be11-4acf-88c6-34be4547e38d")
	)
	(text "STM32: 150 mA\nCAN transceiver: 70 mA\nLEDs: 30 mA\nLCD: 45 mA according to datasheet\n+100mA leakage\n= 365mA -> using 600mA for buck converter (overestimating to be safe)\nCalculations: https://docs.google.com/spreadsheets/d/1epLymsTKMYZpcayYR2TrzBTN5FwB9i6HySkqj1IFzzM/edit?usp=sharing"
		(exclude_from_sim no)
		(at 64.008 150.114 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "62f013f9-cb4b-40e5-8783-b53ae9483595")
	)
	(text "I_in (buck) = (0.6A*3.3V)/(0.95*5V) = 0.417A\n(assuming efficiency = 95%, I_out = 600mA at 3V3)"
		(exclude_from_sim no)
		(at 64.77 167.386 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b403ad0b-eb9d-4cf5-9b1f-7eeaa7dc20f4")
	)
	(text "Start with buck converter, \nif functional then populate"
		(exclude_from_sim no)
