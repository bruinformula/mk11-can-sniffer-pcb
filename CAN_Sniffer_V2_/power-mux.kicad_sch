	(text "V_CP2 = 5*(5.1k/(5.1k+10k))=1.689V > 1.02V Vref, R1=5.1k, R2=10k \nV_PR1 = 4.5V/1.69V = 1/(R1/(R1+R2)) = .375, R1=5.1k, R2=8.2k, PR1=4.40V\n->prioritizes IN1 as long as IN1=4.4V; V_PR1=1.92V > CP2=1.69V is true otherwise\n->LDO low dropout is 1.2V, so prevent anything below about 4.5V"
		(exclude_from_sim no)
		(at 76.962 140.462 0)
		(effects
