	(text "V_CP2 = 5*(5.1k/(5.1k+10k))=1.689V > 1.02V Vref, R1=5.1k, R2=10k \nV_PR1 = 4.5V/1.69V = 1/(R1/(R1+R2)) = .375, R1=5.1k, R2=8.2k, PR1=4.40V\n->prioritizes IN1 as long as IN1=4.4V; V_PR1=1.92V > CP2=1.69V is true otherwise\n->LDO low dropout is 1.2V, so prevent anything below about 4.5V"
		(exclude_from_sim no)
		(at 76.962 140.462 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4eef902b-e07c-41cd-9aa1-22f5ece4da19")
	)
	(text "Using TPS2121 instead: newer model, hot-plugging voltage spike protection, reverse current blocking, soft start\nAutomatic Switchover with Priority (XCOMP): prioritize VBUS power, switchover to auxiliary power RJ45 whenever VBUS is not present \n\nusing R_Ilim=82kOhm, I_lim=65.2/(82^.861)=1.47A; \nI_inrush=100mA max, SR=100mA/100nF=1000V/S"
		(exclude_from_sim yes)
		(at 76.962 124.714 0)
		(effects
