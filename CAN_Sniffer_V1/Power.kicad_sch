	(text "LDO max power dissipation: P_D = (150-25)/88 = 1.42W\n(assuming amb temp = 25 deg C)\n\nLDO needed power dissipation: (5-3.3)*0.6 = 1.02W\n->should be ok, pls correct if dis estimate is wrong"
		(exclude_from_sim no)
		(at 246.126 54.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1f7e3c92-6a82-4e14-9395-1e93918cb8ad")
	)
	(text "PMOS choice:\nR_DS(ON) = 75 mOhm (worst case)\nI_D = 4.6 A\nV_gs(max) = +/- 20V\nV_gs_abs(th) = 2.5V\n-------------------\nZener diode choice:\nV_z = 13V\n\nV_gs = 13-24 = -11V\nP_dissipated = (1A)^2*(.075Ohm) = 72mW"
		(exclude_from_sim yes)
		(at 67.818 118.872 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2dc04a97-e587-47e3-94e4-e4367e2189d3")
	)
	(text "USB Connector (not onboard)"
		(exclude_from_sim yes)
		(at 129.54 101.346 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "37670c56-5e6e-4f65-9f56-068a94fb5a33")
	)
	(text "Using onboard ST-link USB connector for flashing program only (300mA current limit)\nKeep jumper JP5 on E5V always, so onboard USB connector never supplies power or sees rest of PCB\n\nChanged to unidirectional TVS diodes for ESD protection on USB, USB_ID is floating (device only)\n\nRJ45----buck converter---->         ---->LDO---->CAN transceiver, LCD, MicroSD card\nExternal USB connector---->power mux---->MCU E5V, CAN transceiver"
		(exclude_from_sim yes)
		(at 172.466 118.618 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5a1ccac6-3cb8-4b98-81a7-feff8bf14397")
	)
	(text "I_in (buck) = (0.6A*3.3V)/(0.95*5V) = 0.417A\n(assuming efficiency = 95%, I_out = 600mA at 3V3)"
		(exclude_from_sim no)
		(at 132.08 58.928 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "67464f72-fc05-4cb6-a8d6-af35f55dd83a")
	)
