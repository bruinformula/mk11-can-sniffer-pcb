	(text "Note to self:\n\nNeed to check: sus voltage divider on PB4?, USART\n\nChecked:\nCN7_7 (BOOT0) -> default LOW, can be set to HIGH when jumper is on pin5-7 of CN7\nCN7_6 -> E5V\nCN6_8 -> GND\nCN7_5 and CN7_33 -> VDD/VBAT\nNRST (CN7_12) -> 3V3\nCN7_18, CN10_8 -> U5V\nCN7_19, CN7_20, CN10_9, CN10_20 -> GND\nPC_13 -> user button\n\nLD2 (GREEN) -> CN10_11 (PA5)\n\nNot using direct 3V3 input, only E5V and let onboard LDO convert"
		(exclude_from_sim no)
		(at 113.03 155.702 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
